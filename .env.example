# ───────────────────────────────────────────────
# Discord Recovery Bot — 환경변수
# ───────────────────────────────────────────────

# Discord 애플리케이션 (https://discord.com/developers/applications)
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# OAuth2 콜백 URL (Discord 개발자 포털 Redirects에 등록 필요)
# 예: https://yourdomain.com/callback  또는  http://localhost:3000/callback
REDIRECT_URI=http://localhost:3000/callback

# 웹 서버 포트
PORT=3000

# SQLite DB 파일 경로 (기본값: recovery.db)
DB_PATH=recovery.db
